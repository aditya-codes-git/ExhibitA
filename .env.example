# Copy this file to .env in the repository root. Only VITE_ variables reach the browser.
# Use a dedicated ExhibitA project; copy its exact session-pooler URI from Connect.
# Percent-encode special characters in the database password.
DATABASE_URL=
# Supabase Auth project URL and publishable key (the key is safe for browser use).
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Local provisioning command only. Never deploy these or prefix them with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=demo@exhibita.test
DEMO_USER_PASSWORD=
# Optional separate direct/session connection for migrations. Never use port 6543 for migrations.
DIRECT_URL=
# Obtain these from your PayPal Sandbox merchant application, not a live app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Server-side key for the constrained jersey demo agent. Never use in browser code.
GROQ_API_KEY=
# Optional model override; the default supports current Groq tool calling.
GROQ_MODEL=qwen/qwen3.8-27b
# Needed in a later increment when verified webhook ingestion is implemented.
PAYPAL_WEBHOOK_ID=
PORT=3001
FRONTEND_URL=
