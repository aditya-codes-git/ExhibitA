# Server only. Copy this file to .env in the repository root.
# Use a dedicated ExhibitA project; copy its exact session-pooler URI from Connect.
# Percent-encode special characters in the database password.
DATABASE_URL=
# Optional separate direct/session connection for migrations. Never use port 6543 for migrations.
DIRECT_URL=
# Obtain these from your PayPal Sandbox merchant application, not a live app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Needed in a later increment when verified webhook ingestion is implemented.
PAYPAL_WEBHOOK_ID=
PORT=3001
