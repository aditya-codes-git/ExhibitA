generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["exhibita"]
}

model Merchant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  authUserId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  orders    Order[]

  @@schema("exhibita")
}

model Order {
  id               String    @id @default(uuid()) @db.Uuid
  merchantId       String    @db.Uuid
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  amountMinor      Int
  currency         String    @default("USD") @db.VarChar(3)
  status           String    @default("LOCAL_CREATED") @db.VarChar(40)
  paypalOrderId    String?   @unique @db.VarChar(64)
  createRequestId  String    @unique @default(uuid()) @db.Uuid
  captureRequestId String    @unique @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  captures         Capture[]
  evidenceCase     EvidenceCase?
  evidenceEvents   EvidenceEvent[]

  @@index([merchantId, createdAt])
  @@schema("exhibita")
}

model Capture {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paypalCaptureId String   @unique @db.VarChar(64)
  status          String   @db.VarChar(40)
  amountMinor     Int
  currency        String   @db.VarChar(3)
  occurredAt      DateTime @db.Timestamptz(3)
  recordedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, occurredAt])
  @@schema("exhibita")
}

model EvidenceCase {
  orderId           String    @id @db.Uuid
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyerInstruction  String    @db.Text
  itemName          String    @db.VarChar(200)
  shopName          String    @db.VarChar(200)
  agentActionSource String?   @db.VarChar(40)
  agentActionAt     DateTime? @db.Timestamptz(3)
  agentRunStatus    String?   @db.VarChar(40)
  recordedAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@schema("exhibita")
}

model EvidenceEvent {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  source          String   @db.VarChar(40)
  kind            String   @db.VarChar(40)
  externalEventId String   @db.VarChar(120)
  occurredAt      DateTime @db.Timestamptz(3)
  recordedAt      DateTime @default(now()) @db.Timestamptz(3)
  payload         Json     @db.JsonB

  @@unique([orderId, source, externalEventId])
  @@index([orderId, occurredAt, recordedAt])
  @@schema("exhibita")
}
