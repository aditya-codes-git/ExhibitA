{
  "name": "exhibita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "npm run build -w @exhibita/shared && npm run db:generate && concurrently -k -n api,web \"npm run dev -w @exhibita/api\" \"npm run dev -w @exhibita/web\"",
    "build": "npm run build -w @exhibita/shared && npm run db:generate && npm run build -w @exhibita/api && npm run build -w @exhibita/web",
    "typecheck": "npm run build -w @exhibita/shared && npm run db:generate && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build -w @exhibita/shared && vitest run --pool=threads",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "paypal:probe": "tsx apps/api/src/paypal-probe.ts",
    "auth:provision-demo": "tsx apps/api/src/provision-demo-user.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
